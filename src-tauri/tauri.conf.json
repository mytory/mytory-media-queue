{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mytory Media Queue",
  "version": "0.1.0",
  "identifier": "com.mytory.mediaqueue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mytory Media Queue",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "externalBin": ["binaries/deno", "binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["binaries/licenses", "binaries/python", "binaries/wheels"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
